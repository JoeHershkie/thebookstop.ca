---
import { ArrowDown, Sparkles, MapPin, BookOpen, Heart } from 'lucide-react';
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-28 bg-[#fbf8f3]">
  <!-- Subtle Background Accents -->
  <div class="absolute top-0 right-0 -mr-24 -mt-24 w-96 h-96 rounded-full bg-[#852f24]/5 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -ml-24 -mb-24 w-96 h-96 rounded-full bg-[#c28731]/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text & Value Props -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Location Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#852f24]/10 text-[#852f24] text-xs font-mono font-medium tracking-wide">
          <MapPin className="w-3.5 h-3.5" />
          <span>Fort Frances, Northwestern Ontario</span>
        </div>

        <!-- Headline -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl text-[#261916] font-bold tracking-tight leading-[1.15]">
          Handcrafted Planners, Curated Books <span class="italic text-[#852f24]">& Vintage Art.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-[#614f48] max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Welcome to <strong class="text-[#261916] font-semibold">The Book Stop</strong>. Grace hand-binds custom 1-month and 3-month planners with distinctive archival covers, curates pre-loved literary treasures, and hosts community pop-up stands across the Rainy River district.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4">
          <a
            href="#planners"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-[#852f24] hover:bg-[#6e241b] text-[#fbf8f3] font-serif font-bold text-base shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 cursor-pointer text-center"
          >
            <Sparkles className="w-4 h-4 shrink-0" />
            <span>Customize Your Planner</span>
          </a>

          <a
            href="#schedule"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full border border-[#261916]/20 bg-[#f4eee2] hover:bg-[#e8ded0] text-[#261916] font-serif font-medium text-base transition-colors cursor-pointer text-center"
          >
            <span>Next Market Pop-Up</span>
            <ArrowDown className="w-4 h-4 text-[#852f24] shrink-0" />
          </a>
        </div>

        <!-- Micro Highlights / Social Proof -->
        <div class="pt-6 border-t border-[#261916]/10 grid grid-cols-3 gap-2 sm:gap-4 max-w-lg mx-auto lg:mx-0 text-left">
          <div>
            <span class="block font-mono font-bold text-lg sm:text-2xl text-[#852f24]">$10 / $20</span>
            <span class="text-[11px] sm:text-xs text-[#614f48]">Handmade Planners</span>
          </div>
          <div>
            <span class="block font-mono font-bold text-lg sm:text-2xl text-[#852f24]">100%</span>
            <span class="text-[11px] sm:text-xs text-[#614f48]">Locally Bound</span>
          </div>
          <div>
            <span class="block font-mono font-bold text-lg sm:text-2xl text-[#852f24]">Fort Frances</span>
            <span class="text-[11px] sm:text-xs text-[#614f48]">Pickup & Shipping</span>
          </div>
        </div>

      </div>

      <!-- Hero Visuals Collage -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-md">
          
          <!-- Main Hero Photo: Grace wearing vintage sweatshirt -->
          <div class="relative z-10 aspect-4/5 rounded-3xl overflow-hidden shadow-2xl border-4 border-[#fbf8f3] bg-[#f4eee2]">
            <img
              src="/images/grace-sweatshirt.jpg"
              alt="Grace wearing The Book Stop vintage sweatshirt in Fort Frances"
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-xs font-mono uppercase tracking-widest text-[#fbf8f3]/80">Founder & Maker</span>
              <p class="font-serif font-bold text-lg">Grace • The Book Stop</p>
            </div>
          </div>

          <!-- Floating Accent 1: Hand-bound Badge -->
          <div class="absolute -top-6 -left-6 z-20 bg-[#fbf8f3] border border-[#261916]/10 p-3.5 rounded-2xl shadow-lg flex items-center gap-3 hidden sm:flex">
            <div class="w-10 h-10 rounded-xl bg-[#852f24]/10 text-[#852f24] flex items-center justify-center">
              <Heart className="w-5 h-5 fill-[#852f24]" />
            </div>
            <div class="text-left">
              <span class="block text-xs font-bold text-[#261916]">Hand-bound with love</span>
              <span class="text-[10px] text-[#614f48]">Custom covers & paper</span>
            </div>
          </div>

          <!-- Floating Accent 2: Booth Snapshot -->
          <div class="absolute -bottom-8 -right-6 z-20 w-36 sm:w-44 aspect-square rounded-2xl overflow-hidden border-4 border-[#fbf8f3] shadow-xl bg-[#f4eee2] hidden sm:block">
            <img
              src="/images/market-setup.jpg"
              alt="The Book Stop Market Pop-up Setup"
              class="w-full h-full object-cover"
            />
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
