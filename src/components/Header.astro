---
import CartToggle from './CartToggle';
---

<header class="sticky top-0 z-40 w-full border-b border-[#261916]/10 bg-[#fbf8f3]/90 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Title -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="relative w-12 h-12 rounded-full overflow-hidden border-2 border-[#852f24] shadow-xs group-hover:scale-105 transition-transform duration-200">
          <img
            src="/images/logo.jpg"
            alt="The Book Stop Logo"
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <span class="font-serif font-bold text-xl sm:text-2xl text-[#261916] tracking-tight group-hover:text-[#852f24] transition-colors">
            The Book Stop
          </span>
          <span class="block text-[10px] font-mono tracking-widest text-[#852f24] uppercase">
            Fort Frances, Ontario
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#261916]">
        <a href="#planners" class="hover:text-[#852f24] transition-colors py-1">
          Planners & Notebooks
        </a>
        <a href="#schedule" class="hover:text-[#852f24] transition-colors py-1">
          Market Dates
        </a>
        <a href="#books" class="hover:text-[#852f24] transition-colors py-1">
          Books & Vintage Art
        </a>
        <a href="#story" class="hover:text-[#852f24] transition-colors py-1">
          About Grace
        </a>
        <a href="#contact" class="hover:text-[#852f24] transition-colors py-1">
          Contact
        </a>
      </nav>

      <!-- Cart Toggle & Mobile Menu Trigger -->
      <div class="flex items-center gap-3">
        <CartToggle client:load />

        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2 rounded-xl text-[#261916] hover:bg-[#852f24]/10 transition-colors cursor-pointer"
          aria-label="Toggle mobile menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#261916]/10 bg-[#f8f4ee] px-4 pt-3 pb-6 space-y-3">
    <a href="#planners" class="block py-2 text-base font-serif font-medium text-[#261916] hover:text-[#852f24] mobile-link">
      Planners & Notebooks
    </a>
    <a href="#schedule" class="block py-2 text-base font-serif font-medium text-[#261916] hover:text-[#852f24] mobile-link">
      Market Dates
    </a>
    <a href="#books" class="block py-2 text-base font-serif font-medium text-[#261916] hover:text-[#852f24] mobile-link">
      Books & Vintage Art
    </a>
    <a href="#story" class="block py-2 text-base font-serif font-medium text-[#261916] hover:text-[#852f24] mobile-link">
      About Grace
    </a>
    <a href="#contact" class="block py-2 text-base font-serif font-medium text-[#261916] hover:text-[#852f24] mobile-link">
      Contact
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
