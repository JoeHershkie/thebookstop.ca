---
import { Phone, Mail, MapPin, Facebook, Instagram, Heart, ArrowUp } from 'lucide-react';
---

<footer id="contact" class="bg-[#261916] text-[#fbf8f3] pt-16 pb-12 border-t-4 border-[#852f24]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/logo.png"
            alt="The Book Stop Logo"
            class="w-10 h-10 shrink-0 object-contain"
          />
          <span class="font-serif font-bold text-2xl tracking-tight text-[#fbf8f3]">
            The Book Stop
          </span>
        </div>

        <p class="text-xs sm:text-sm text-[#fbf8f3]/70 leading-relaxed max-w-sm">
          Handcrafted 1-month and 3-month planners, curated pre-loved books, and vintage framed art prints made with care in Fort Frances, Northwestern Ontario.
        </p>

        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://www.facebook.com/profile.php?id=100075995475117"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-[#852f24] flex items-center justify-center text-[#fbf8f3] transition-colors"
            aria-label="Facebook Page"
          >
            <Facebook className="w-4 h-4" />
          </a>
          <a
            href="https://www.instagram.com/TheBookStop2026"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-[#852f24] flex items-center justify-center text-[#fbf8f3] transition-colors"
            aria-label="Instagram Profile"
          >
            <Instagram className="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="font-serif font-bold text-sm tracking-wider uppercase text-[#c28731]">
          Explore
        </h4>
        <ul class="space-y-2 text-xs text-[#fbf8f3]/70">
          <li>
            <a href="#planners" class="hover:text-white transition-colors">
              Custom Planners ($10 / $20)
            </a>
          </li>
          <li>
            <a href="#schedule" class="hover:text-white transition-colors">
              Upcoming Market Pop-Ups
            </a>
          </li>
          <li>
            <a href="#books" class="hover:text-white transition-colors">
              Curated Books & Framed Art
            </a>
          </li>
          <li>
            <a href="#story" class="hover:text-white transition-colors">
              About Grace & The Stand
            </a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact & Hours -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="font-serif font-bold text-sm tracking-wider uppercase text-[#c28731]">
          Get in Touch
        </h4>
        <div class="space-y-2.5 text-xs text-[#fbf8f3]/80">
          <div class="flex items-center gap-2.5">
            <Phone className="w-4 h-4 text-[#852f24] shrink-0" />
            <a href="tel:+18072713557" class="hover:underline text-white font-medium">
              +1 (807) 271-3557
            </a>
          </div>

          <div class="flex items-center gap-2.5">
            <Mail className="w-4 h-4 text-[#852f24] shrink-0" />
            <a href="mailto:graciep910@gmail.com" class="hover:underline text-white font-medium">
              graciep910@gmail.com
            </a>
          </div>

          <div class="flex items-start gap-2.5">
            <MapPin className="w-4 h-4 text-[#852f24] shrink-0 mt-0.5" />
            <span>Fort Frances, Ontario, Canada (Rainy River District)</span>
          </div>
        </div>

        <div class="p-3 rounded-xl bg-white/5 border border-white/10 mt-3 text-[11px] text-[#fbf8f3]/70">
          <strong>Order Payments:</strong> We accept Interac e-Transfer to <span class="text-white font-mono">graciep910@gmail.com</span> for online orders, plus cash and e-Transfer at our market booths.
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#fbf8f3]/50">
      <p>
        © 2026 The Book Stop (thebookstop.ca). All rights reserved.
      </p>

      <div class="flex items-center gap-4">
        <span>Handcrafted with pride in Fort Frances</span>
        <a href="#" class="p-2 rounded-full bg-white/10 hover:bg-[#852f24] text-white transition-colors" aria-label="Back to top">
          <ArrowUp className="w-4 h-4" />
        </a>
      </div>
    </div>

  </div>
</footer>
